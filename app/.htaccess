# Blokir akses langsung ke folder aplikasi (app/) dari web.
# Catatan: server lokal kamu memakai AllowOverride None, jadi blok
# di bawah hanya aktif di hosting dengan AllowOverride All.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>